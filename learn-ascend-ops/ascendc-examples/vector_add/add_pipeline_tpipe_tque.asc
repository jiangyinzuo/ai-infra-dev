#include <cstdint>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLOCK_LENGTH = 16 * 1024;
constexpr uint32_t TILE_LENGTH = 1024;
constexpr uint32_t TILES_PER_BLOCK = BLOCK_LENGTH / TILE_LENGTH;
constexpr uint32_t BUFFER_NUM = 2;

__global__ __vector__ void add_pipeline_tpipe_tque(
    __gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueY;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueZ;
    AscendC::GlobalTensor<float> xGm, yGm, zGm;
    uint32_t blockOffset = AscendC::GetBlockIdx() * BLOCK_LENGTH;
    xGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x) + blockOffset, BLOCK_LENGTH);
    yGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(y) + blockOffset, BLOCK_LENGTH);
    zGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(z) + blockOffset, BLOCK_LENGTH);

    pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(float));
    pipe.InitBuffer(inQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(float));
    pipe.InitBuffer(outQueueZ, BUFFER_NUM, TILE_LENGTH * sizeof(float));

    // One outstanding tensor per queue; two buffers allow reuse across iterations.
    for (uint32_t tile = 0; tile < TILES_PER_BLOCK; ++tile) {
        AscendC::LocalTensor<float> xLocal = inQueueX.AllocTensor<float>();
        AscendC::LocalTensor<float> yLocal = inQueueY.AllocTensor<float>();
        AscendC::DataCopy(xLocal, xGm[tile * TILE_LENGTH], TILE_LENGTH);
        AscendC::DataCopy(yLocal, yGm[tile * TILE_LENGTH], TILE_LENGTH);
        inQueueX.EnQue(xLocal);
        inQueueY.EnQue(yLocal);

        xLocal = inQueueX.DeQue<float>();
        yLocal = inQueueY.DeQue<float>();
        AscendC::LocalTensor<float> zLocal = outQueueZ.AllocTensor<float>();
        AscendC::Add(zLocal, xLocal, yLocal, TILE_LENGTH);
        AscendC::Muls(zLocal, zLocal, 1.25f, TILE_LENGTH);
        outQueueZ.EnQue<float>(zLocal);
        inQueueX.FreeTensor(xLocal);
        inQueueY.FreeTensor(yLocal);

        zLocal = outQueueZ.DeQue<float>();
        AscendC::DataCopy(zGm[tile * TILE_LENGTH], zLocal, TILE_LENGTH);
        outQueueZ.FreeTensor(zLocal);
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t totalLength = NUM_BLOCKS * BLOCK_LENGTH;
    constexpr size_t byteSize = totalLength * sizeof(float);
    uint8_t* xHost = nullptr;
    uint8_t* yHost = nullptr;
    uint8_t* zHost = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* yDevice = nullptr;
    uint8_t* zDevice = nullptr;
    size_t xFileSize = 0;
    size_t yFileSize = 0;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&xHost), byteSize);
    aclrtMallocHost((void**)(&yHost), byteSize);
    aclrtMallocHost((void**)(&zHost), byteSize);
    aclrtMalloc((void**)&xDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    if (!ReadFile("./pipeline_input/input_x.bin", xFileSize, xHost, byteSize) ||
        !ReadFile("./pipeline_input/input_y.bin", yFileSize, yHost, byteSize) ||
        xFileSize != byteSize || yFileSize != byteSize) {
        return 1;
    }
    aclrtMemcpy(xDevice, byteSize, xHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, byteSize, yHost, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    add_pipeline_tpipe_tque<<<NUM_BLOCKS, nullptr, stream>>>(xDevice, yDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, byteSize, zDevice, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./pipeline_output/tpipe_tque.bin", zHost, byteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
