# 使用 source 加载；按本文件位置查找工具，不依赖当前目录或固定版本号。
_devtools_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
_devtools_path=$_devtools_dir
for _devtools_bin in \
    "$_devtools_dir/bin" \
    "$_devtools_dir/nvim-linux-arm64/bin" \
    "$_devtools_dir"/node-v*-linux-arm64/bin \
    "$_devtools_dir"/ripgrep-*-aarch64-unknown-linux-musl \
    "$_devtools_dir"/fd-v*-aarch64-unknown-linux-musl \
    "$_devtools_dir"/delta-*-aarch64-unknown-linux-gnu; do
    [[ -d $_devtools_bin ]] || continue
    _devtools_path+=":$_devtools_bin"
done
export PATH="$HOME/.local/bin:$_devtools_path:$PATH"
unset _devtools_dir _devtools_path _devtools_bin
