if [[ $(uname -r) != *[Mm]icrosoft* ]]; then
  export http_proxy="http://$USG_IP:3128"
  export https_proxy="http://$USG_IP:3128"
  export all_proxy="http://$USG_IP:3128"
  export HTTP_PROXY="http://$USG_IP:3128"
  export HTTPS_PROXY="http://$USG_IP:3128"
  export ALL_PROXY="http://$USG_IP:3128"
else
  echo "WSL 不要source这个proxy"
fi
